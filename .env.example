# =================================================================
# Pulse - Local Docker Compose Environment Template
# Copy this file to '.env' for local customization.
# Do NOT store production credentials or private keys in this file.
# =================================================================

# Database Configuration (PostgreSQL 16)
POSTGRES_DB=pulse
POSTGRES_USER=pulse
POSTGRES_PASSWORD=pulse
POSTGRES_HOST_PORT=5433

# Application Ports
BACKEND_PORT=8080
MAILPIT_WEB_PORT=8025

# JWT Secret: REQUIRED. Must be a Base64-encoded string of at least 32 bytes (256 bits) for HMAC-SHA256.
# On Linux/macOS, generate with: openssl rand -base64 32
# On Windows PowerShell, generate with:
#   $bytes = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($bytes); [Convert]::ToBase64String($bytes)
# DO NOT commit real secrets to Git.
JWT_SECRET=REPLACE_WITH_BASE64_ENCODED_32_BYTE_SECRET

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173
